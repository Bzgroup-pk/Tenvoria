# Frontend-safe values only. These may be included in the browser bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# NEVER put service-role keys or model API keys in VITE_* variables.
# Configure server-only secrets in Supabase Edge Function settings instead.
# SUPABASE_SERVICE_ROLE_KEY=server-only
# AI_PROVIDER_API_KEY=server-only
# APP_ORIGIN=https://your-approved-domain.example
