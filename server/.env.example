# Copy to .env. Never commit .env or real credentials.
NODE_ENV=development
PORT=8788
APP_ORIGIN=http://localhost:5173
PUBLIC_APP_ORIGIN=http://localhost:5174
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require
JWT_SECRET=replace-with-at-least-32-random-characters
FOUNDER_EMAIL=founder@example.com
FOUNDER_PASSWORD=replace-with-a-strong-one-time-password
# Hermes runs as a separate worker process, never inside a public HTTP request.
HERMES_ENABLED=false
HERMES_BIN=hermes
HERMES_TIMEOUT_MS=180000
HERMES_WORKSPACE=./agent-workspace
# Default off: public users' jobs do not run until you intentionally enable them.
PUBLIC_AGENT_EXECUTION_ENABLED=false
